# Supabase client configuration. These values are public in a Flutter app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local Supabase Edge Function development only. Never pass this to Flutter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Anchor blockchain relayer (Edge Function secrets, set via `supabase secrets set`).
# Never pass these to Flutter or commit them.
ANCHOR_PRIVATE_KEY=
ANCHOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ANCHOR_CHAIN_ID=11155111
ANCHOR_CHAIN_NAME=Ethereum Sepolia (testnet)
ANCHOR_EXPLORER_URL=https://sepolia.etherscan.io
ANCHOR_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
